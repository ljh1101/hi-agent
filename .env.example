# Copy to `.env` and fill in your key. `.env` is git-ignored.

# Any OpenAI-compatible endpoint works (OpenAI, DeepSeek, Moonshot, Ollama, vLLM, ...).
AGENT_API_KEY=sk-xxxxxxxxxxxxxxxx
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4o-mini

# Optional shortcuts, used when AGENT_* is not set:
# OPENAI_API_KEY=...
# DEEPSEEK_API_KEY=...        # auto-selects https://api.deepseek.com/v1 + deepseek-chat
