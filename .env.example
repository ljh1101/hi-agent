# Optional. hi-agent resolves configuration in this order:
#
#   CLI flags > environment variables > project `hi-agent.json` > global config
#
# The recommended setup needs no `.env` at all: run `npm run dev` and answer
# the one-time API-key prompt, which saves to ~/.config/hi-agent/config.json
# (0600, never committed). A project may commit a secret-free `hi-agent.json`:
#
#   { "baseURL": "https://api.openai.com/v1", "model": "gpt-4o-mini" }
#
# The variables below override those files when you need a per-run override.

# Any OpenAI-compatible endpoint works (OpenAI, DeepSeek, Moonshot, Ollama, vLLM, ...).
AGENT_API_KEY=sk-xxxxxxxxxxxxxxxx
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4o-mini

# Wire protocol for the endpoint: openai (default) | anthropic | google.
# Unset, it is inferred from a known base URL (the native Anthropic/Google
# endpoints); set it for proxied or custom native endpoints.
# AGENT_PROTOCOL=openai

# Search backend for the web_search tool (both lines together; alternatively
# configure "webSearch" in the global config):
# WEB_SEARCH_PROVIDER=brave    # brave | exa | perplexity
# WEB_SEARCH_API_KEY=

# Optional shortcuts, used when AGENT_* is not set:
# OPENAI_API_KEY=...
# DEEPSEEK_API_KEY=...        # auto-selects https://api.deepseek.com/v1 + deepseek-chat
